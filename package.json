{
  "name": "mcp-studio",
  "version": "0.0.0",
  "description": "Postman for MCP: connect to any MCP server, fill a form from each tool's JSON Schema, fire the call, and save calls into Collections with checks.",
  "type": "module",
  "license": "MIT",
  "author": "Ron Masuary <ronmas2@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronmasuary/mcp-studio.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "prepack": "npm run build:all",
    "setup": "npm install && npm --prefix web install && npm run build:all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && eslint --config web/eslint.config.js web",
    "test": "vitest run",
    "test:web": "npm --prefix web run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
